# CareerSphere Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Server Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database Settings
# For SQLite (default development):
DATABASE_URL=sqlite:///backend/data/careersphere.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/careersphere?sslmode=require

# Authentication Security (Generate a strong 64-char key in production)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated for multiple domains, or * for open)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com

# Ingestion Worker Interval (in seconds, default 14400 = 4 hours)
INGESTION_INTERVAL_SECONDS=14400
